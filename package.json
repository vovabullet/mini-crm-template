{
  "name": "mini-crm",
  "private": true,
  "version": "0.1.0",
  "description": "Мини-CRM для исполнителей: React + shadcn/ui (frontend) и Django (backend)",
  "scripts": {
    "setup": "npm install && npm --prefix frontend install && node scripts/backend.mjs setup",
    "setup:api": "node scripts/backend.mjs setup",
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node scripts/backend.mjs run",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "seed": "node scripts/backend.mjs manage seed_demo --reset",
    "manage": "node scripts/backend.mjs manage"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
